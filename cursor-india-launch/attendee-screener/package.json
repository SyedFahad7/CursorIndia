{
  "name": "attendee-screener",
  "version": "0.1.0",
  "private": true,
  "description": "Local Luma CSV attendee screener powered by Cursor SDK (Pro plan models)",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "screen": "tsx src/cli.ts screen",
    "export-decisions": "tsx src/cli.ts export-decisions",
    "ui": "tsx src/server.ts",
    "enqueue": "tsx scripts/enqueue-live.ts",
    "roadshow:prepare": "tsx scripts/prepare-roadshow.ts",
    "roadshow:run": "tsx scripts/run-roadshow-batches.ts",
    "roadshow:merge": "tsx scripts/merge-roadshow-accepts.ts",
    "roadshow:ready": "tsx scripts/ready-to-approve.ts",
    "eval": "tsx evals/run.ts",
    "test": "tsx --test src/pipeline/slop.test.ts src/pipeline/normalize.test.ts src/pipeline/preflight.test.ts",
    "typecheck": "tsc --noEmit",
    "ra:prepare": "tsx scripts/prepare-ra-run.ts"
  },
  "dependencies": {
    "@cursor/sdk": "^1.0.23",
    "commander": "^14.0.0",
    "csv-parse": "^6.1.0",
    "csv-stringify": "^6.6.0",
    "dotenv": "^17.2.1",
    "octokit": "^5.0.3",
    "zod": "^4.0.14"
  },
  "devDependencies": {
    "@types/node": "^22.16.5",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2"
  }
}
