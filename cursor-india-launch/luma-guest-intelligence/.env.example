# Required for real Cursor scoring
CURSOR_API_KEY=cursor_...

# Model used by @cursor/sdk Agent.prompt
CURSOR_MODEL=composer-2.5

# Shared secret Workato sends as Authorization: Bearer <token>
# or header X-Api-Key. Keep "dev-local-key" for local dashboard (auth skipped).
API_KEY=dev-local-key

PORT=8790

# Demo defaults (override via POST /v1/config)
DEFAULT_BATCH_SIZE=5
DEFAULT_TARGET_ACCEPTS=80
DEFAULT_EVENT_NAME=AI Builders Meetup: Build Club Launch [Hyderabad]

# Optional WhatsApp invite line in approval messages
WHATSAPP_INVITE_URL=
