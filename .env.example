# SMTP credentials for the contact form (Gmail: use an App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Where contact form submissions are delivered
CONTACT_TO=syedfahad.dev@gmail.com

# ── Ambassador admin (recaps) ─────────────────────────────────────────────
# Generate ADMIN_SESSION_SECRET (PowerShell):
#   [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }) -as [byte[]])
ADMIN_SESSION_SECRET=

# One password per city slug (JSON). Ambassadors use /admin/<city>
# Example: {"hyderabad":"CityHyderabad2026","bengaluru":"CityBengaluru2026"}
CITY_ADMIN_PASSWORDS={}

# ── Supabase (recap database + photo storage) ─────────────────────────────
# Setup guide: docs/supabase-setup.md
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Project Settings → API → service_role (secret — server only, never commit)
SUPABASE_SERVICE_ROLE_KEY=

# If uploads/Luma fail locally with certificate errors on Windows, use this instead:
# Uses a scoped TLS bypass (not NODE_TLS_REJECT_UNAUTHORIZED). Dev only.
DEV_RELAX_TLS=1
